# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by the Telegram bot and the nightly cron. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Free AI fallback for messy entries (https://console.groq.com/keys). Optional: without it, only the rule parser runs.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Voice notes (iPhone, Firefox, Telegram) use the same key. Chrome uses the browser's own speech recognition.
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Or use Gemini's free tier instead: AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Telegram bot from @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=KudiLogBot
# Any random string. Telegram sends it back on every webhook call so we know it's really Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Vercel Cron sends this as a Bearer token
CRON_SECRET=

# Public URL of the deployed site, e.g. https://kudi-log.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
